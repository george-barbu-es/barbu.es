---
import { buildSeo, type SeoProps } from '../lib/seo';
import { site } from '../config/site';

type Props = SeoProps;

const seo = buildSeo(Astro.props);
const { ogImage } = seo;
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />
{seo.noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={seo.ogType} />
<meta property="og:title" content={seo.socialTitle} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:locale" content="en_GB" />
<meta property="og:image" content={ogImage.url} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={ogImage.alt} />

<meta name="twitter:card" content={seo.twitterCard} />
<meta name="twitter:title" content={seo.socialTitle} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={ogImage.url} />
<meta name="twitter:image:alt" content={ogImage.alt} />

<link rel="alternate" type="application/rss+xml" title={`${site.name} Writing`} href="/rss.xml" />
