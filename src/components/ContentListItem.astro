---
/**
 * Typographic list row — path-style, not cards.
 */
import { withTrailingSlash } from '../lib/seo';

type Props = {
  href: string;
  title: string;
  description?: string;
  meta?: string;
  badge?: string;
};

const { href, title, description, meta, badge } = Astro.props;
const to = withTrailingSlash(href);
---

<li class="content-row">
  <a class="content-row__link" href={to}>
    <div class="content-row__top">
      <h2 class="content-row__title">{title}</h2>
      {badge && <span class="content-row__badge">{badge}</span>}
    </div>
    {description && <p class="content-row__desc">{description}</p>}
    {meta && <p class="content-row__meta">{meta}</p>}
  </a>
</li>

<style>
  .content-row {
    list-style: none;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .content-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .content-row__link {
    display: block;
    padding-block: var(--space-5);
    text-decoration: none;
    color: inherit;
  }

  .content-row__link:hover .content-row__title {
    color: var(--color-accent);
  }

  .content-row__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .content-row__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: var(--leading-snug);
    color: var(--color-fg);
  }

  .content-row__badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
  }

  .content-row__desc {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .content-row__meta {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
