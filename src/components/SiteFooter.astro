---
import { externalCtas, socialProfiles, site, external } from '../config/site';
import { person } from '../config/person';

const year = new Date().getFullYear();

const links = [
  ...socialProfiles.map((item) => ({
    href: item.href,
    label: item.label.toLowerCase(),
    rel: 'me noopener noreferrer' as const,
  })),
  ...externalCtas.map((item) => ({
    href: item.href,
    label: item.label.toLowerCase(),
    rel: 'noopener noreferrer' as const,
  })),
  {
    href: external.company,
    label: 'infowebplus',
    rel: 'noopener noreferrer' as const,
  },
];
---

<footer class="site-footer">
  <div class="site-shell site-footer__inner">
    <a href="/" class="site-footer__name">{site.name}</a>

    <p class="site-footer__meta">
      Frontend Platform Lead, Spain, EU remote,{' '}
      <a class="site-footer__email" href={`mailto:${person.email}`}>{person.email}</a>
    </p>

    <nav class="site-footer__links" aria-label="Contact and profiles">
      <p class="site-footer__linkline">
        {
          links.map((item, index) => (
            <>
              {index > 0 && <span class="site-footer__sep" aria-hidden="true"> / </span>}
              <a href={item.href} rel={item.rel}>
                {item.label}
              </a>
            </>
          ))
        }
      </p>
    </nav>

    <p class="site-footer__copy">
      © {year} {person.name}. {site.url.replace('https://', '')}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-10) var(--space-8);
    background: var(--color-surface);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-3);
  }

  .site-footer__name {
    width: fit-content;
    text-decoration: none;
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .site-footer__name:hover {
    color: var(--color-accent);
  }

  .site-footer__meta {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .site-footer__email {
    font-family: var(--font-mono);
    text-decoration: none;
    color: var(--color-muted);
  }

  .site-footer__email:hover {
    color: var(--color-accent);
  }

  .site-footer__linkline {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .site-footer__sep {
    color: var(--color-border-strong);
  }

  .site-footer__linkline a {
    text-decoration: none;
    color: var(--color-fg);
  }

  .site-footer__linkline a:hover {
    color: var(--color-accent);
  }

  .site-footer__copy {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
</style>
