---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import ContentListItem from '../../components/ContentListItem.astro';
import { sortWork } from '../../lib/content';
import {
  buildBreadcrumbJsonLd,
  buildItemListJsonLd,
  buildWebPageJsonLd,
} from '../../lib/schema/jsonld';
import { resolveUrl } from '../../lib/seo';
import { external } from '../../config/site';

const description =
  'Selected work by George Barbu: factual depth, earned authority, no invented metrics. Full archive on portfolio.barbu.es.';
const url = resolveUrl('/work');
const entries = sortWork(
  (await getCollection('work')).filter((entry) => !entry.data.draft),
);
const pageLd = buildWebPageJsonLd({
  url,
  name: 'Work',
  description,
  type: 'CollectionPage',
});
const listLd = buildItemListJsonLd({
  name: 'Selected work by George Barbu',
  items: entries.map((entry) => ({
    name: entry.data.title,
    url: resolveUrl(`/work/${entry.id}`),
  })),
});
const crumbs = buildBreadcrumbJsonLd([
  { name: 'Home', url: resolveUrl('/') },
  { name: 'Work', url },
]);
---

<BaseLayout title="Work" description={description} path="/work" jsonLd={[pageLd, listLd, crumbs]}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Work' }]} />

  <header class="page-header">
    <h1>Work</h1>
    <p>Selected work only: what is real and clear to cite. Full archive lives elsewhere.</p>
  </header>

  <p style="margin-bottom: var(--space-8)">
    <Button href={external.portfolio} variant="secondary" external>
      View Full Portfolio
    </Button>
  </p>

  <ul class="content-list">
    {
      entries.map((entry) => (
        <ContentListItem
          href={`/work/${entry.id}`}
          title={entry.data.title}
          description={entry.data.description}
          badge={entry.data.featured ? 'Featured' : undefined}
        />
      ))
    }
  </ul>
</BaseLayout>

<style>
  .content-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
