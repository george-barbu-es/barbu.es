---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Prose from '../components/Prose.astro';
import { getPageByPath } from '../lib/content';
import { buildBreadcrumbJsonLd, buildWebPageJsonLd } from '../lib/schema/jsonld';
import { resolveUrl } from '../lib/seo';

const entry = await getPageByPath('/about');
if (!entry) throw new Error('Missing content/pages entry for /about');

const { Content } = await render(entry);
const url = resolveUrl('/about');
const pageLd = buildWebPageJsonLd({
  url,
  name: entry.data.title,
  description: entry.data.description,
  type: entry.data.schemaType,
});
const crumbs = buildBreadcrumbJsonLd([
  { name: 'Home', url: resolveUrl('/') },
  { name: entry.data.title, url },
]);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path="/about"
  type="profile"
  jsonLd={[pageLd, crumbs]}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: entry.data.title }]} />

  <header class="page-header">
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
  </header>

  {
    entry.data.draft && (
      <p class="placeholder-note" style="margin-bottom: var(--space-8)">
        IA placeholder (draft). Full story in Milestone 4. No invented biography.
      </p>
    )
  }

  <Prose>
    <Content />
  </Prose>
</BaseLayout>
